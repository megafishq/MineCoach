#include <windows.h>

// Application Icon
IDI_ICON1 ICON DISCARDABLE "libremines.ico"

// Version Information
VS_VERSION_INFO VERSIONINFO
FILEVERSION     @LIBREMINES_VERSION_MAJOR@,@LIBREMINES_VERSION_MINOR@,@LIBREMINES_VERSION_PATCH@,@LIBREMINES_VERSION_BUILD@
PRODUCTVERSION  @LIBREMINES_VERSION_MAJOR@,@LIBREMINES_VERSION_MINOR@,@LIBREMINES_VERSION_PATCH@,@LIBREMINES_VERSION_BUILD@
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"  // US English, Unicode
        BEGIN
            VALUE "CompanyName",      "MineCoach contributors"
            VALUE "FileDescription",  "MineCoach - Minesweeper trainer (based on LibreMines)"
            VALUE "FileVersion",      "@PROJECT_VERSION@.0"
            VALUE "InternalName",     "@PROJECT_NAME@"
            VALUE "LegalCopyright",   "Copyright (C) 2020-2026 Bruno Bollos Correa; 2026 MineCoach contributors. GPL-3.0-or-later"
            VALUE "OriginalFilename", "@PROJECT_NAME@.exe"
            VALUE "ProductName",      "MineCoach"
            VALUE "ProductVersion",   "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200  // US English, Unicode
    END
END
